{
  "name": "apchi-web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "api": "openapi-typescript ../openapi.json -o src/api/schema.d.ts",
    "api:check": "openapi-typescript ../openapi.json -o /tmp/apchi-schema-check.d.ts && diff -q src/api/schema.d.ts /tmp/apchi-schema-check.d.ts",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@tanstack/react-query": "5.66.0",
    "openapi-fetch": "0.13.4",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-router-dom": "7.1.5"
  },
  "devDependencies": {
    "@playwright/test": "1.50.1",
    "@types/node": "^22.13.1",
    "@types/react": "19.0.8",
    "@types/react-dom": "19.0.3",
    "@vitejs/plugin-react": "4.3.4",
    "eslint": "9.20.1",
    "openapi-typescript": "7.6.1",
    "typescript": "5.7.3",
    "typescript-eslint": "8.24.0",
    "vite": "6.1.0"
  }
}
