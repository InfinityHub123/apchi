{
  "components": {
    "schemas": {
      "ApplyRecord": {
        "properties": {
          "base_snapshot": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Base Snapshot"
          },
          "failure_reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Failure Reason"
          },
          "finished_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Finished At"
          },
          "history": {
            "items": {
              "$ref": "#/components/schemas/StageEvent"
            },
            "title": "History",
            "type": "array"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "interrupted": {
            "default": false,
            "description": "True when an Apchi restart ended this Apply rather than a failure in it. The Cluster was still put back; what differs is why.",
            "title": "Interrupted",
            "type": "boolean"
          },
          "operator_message": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "What to show an Operator. Set when an Apply ends in an incident.",
            "title": "Operator Message"
          },
          "rollback": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Rollback"
              },
              {
                "type": "null"
              }
            ],
            "description": "The outcome of Auto Rollback. Absent when none was attempted, which means nothing reached the Cluster."
          },
          "snapshot": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "The Snapshot this Apply committed, when it succeeded.",
            "title": "Snapshot"
          },
          "stage": {
            "$ref": "#/components/schemas/Stage"
          },
          "started_at": {
            "format": "date-time",
            "title": "Started At",
            "type": "string"
          }
        },
        "required": [
          "id",
          "stage",
          "started_at"
        ],
        "title": "ApplyRecord",
        "type": "object"
      },
      "Catalog": {
        "description": "A Catalog as it is stored and returned.",
        "properties": {
          "connector": {
            "pattern": "^[a-z][a-z0-9_-]{0,62}$",
            "title": "Connector",
            "type": "string"
          },
          "name": {
            "pattern": "^[a-z][a-z0-9_]{0,62}$",
            "title": "Name",
            "type": "string"
          },
          "properties": {
            "additionalProperties": {
              "type": "string"
            },
            "title": "Properties",
            "type": "object"
          },
          "supported": {
            "description": "False when the connector has no curated schema. Its properties passed through unvalidated and are checked only by Trino at Apply.",
            "title": "Supported",
            "type": "boolean"
          }
        },
        "required": [
          "name",
          "connector",
          "supported"
        ],
        "title": "Catalog",
        "type": "object"
      },
      "CatalogUpdate": {
        "additionalProperties": false,
        "description": "A partial update. The name is immutable; renaming is a drop and a create,\nwhich is a different and more destructive operation.",
        "properties": {
          "connector": {
            "anyOf": [
              {
                "pattern": "^[a-z][a-z0-9_-]{0,62}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Connector"
          },
          "properties": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Properties"
          }
        },
        "title": "CatalogUpdate",
        "type": "object"
      },
      "CatalogWrite": {
        "additionalProperties": false,
        "description": "What an Operator sends.",
        "properties": {
          "connector": {
            "pattern": "^[a-z][a-z0-9_-]{0,62}$",
            "title": "Connector",
            "type": "string"
          },
          "name": {
            "pattern": "^[a-z][a-z0-9_]{0,62}$",
            "title": "Name",
            "type": "string"
          },
          "properties": {
            "additionalProperties": true,
            "title": "Properties",
            "type": "object"
          }
        },
        "required": [
          "name",
          "connector"
        ],
        "title": "CatalogWrite",
        "type": "object"
      },
      "EngagedBy": {
        "enum": [
          "admin",
          "auto_rollback_failure"
        ],
        "title": "EngagedBy",
        "type": "string"
      },
      "EventListener": {
        "description": "An Event Listener as it is stored and returned.",
        "properties": {
          "name": {
            "pattern": "^[a-z][a-z0-9_]{0,62}$",
            "title": "Name",
            "type": "string"
          },
          "properties": {
            "additionalProperties": {
              "type": "string"
            },
            "title": "Properties",
            "type": "object"
          },
          "supported": {
            "description": "False when the listener type has no curated schema. Its properties passed through unvalidated and are checked only by Trino at Apply.",
            "title": "Supported",
            "type": "boolean"
          },
          "type": {
            "pattern": "^[a-z][a-z0-9_-]{0,62}$",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "name",
          "type",
          "supported"
        ],
        "title": "EventListener",
        "type": "object"
      },
      "EventListenerUpdate": {
        "additionalProperties": false,
        "description": "A partial update. The name is immutable; renaming is a remove and an add.",
        "properties": {
          "properties": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Properties"
          },
          "type": {
            "anyOf": [
              {
                "pattern": "^[a-z][a-z0-9_-]{0,62}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Type"
          }
        },
        "title": "EventListenerUpdate",
        "type": "object"
      },
      "EventListenerWrite": {
        "additionalProperties": false,
        "description": "What an Operator sends.",
        "properties": {
          "name": {
            "pattern": "^[a-z][a-z0-9_]{0,62}$",
            "title": "Name",
            "type": "string"
          },
          "properties": {
            "additionalProperties": true,
            "title": "Properties",
            "type": "object"
          },
          "type": {
            "pattern": "^[a-z][a-z0-9_-]{0,62}$",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "name",
          "type"
        ],
        "title": "EventListenerWrite",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "Health": {
        "properties": {
          "mongo": {
            "title": "Mongo",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "mongo"
        ],
        "title": "Health",
        "type": "object"
      },
      "MaintenanceState": {
        "properties": {
          "engaged": {
            "default": false,
            "title": "Engaged",
            "type": "boolean"
          },
          "engaged_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Engaged At"
          },
          "engaged_by": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/EngagedBy"
              },
              {
                "type": "null"
              }
            ]
          },
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason"
          }
        },
        "title": "MaintenanceState",
        "type": "object"
      },
      "Outcome": {
        "enum": [
          "running",
          "passed",
          "failed"
        ],
        "title": "Outcome",
        "type": "string"
      },
      "ResourceChange": {
        "properties": {
          "after": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "After"
          },
          "before": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Before"
          },
          "change": {
            "enum": [
              "added",
              "changed",
              "removed"
            ],
            "title": "Change",
            "type": "string"
          },
          "resource": {
            "title": "Resource",
            "type": "string"
          }
        },
        "required": [
          "resource",
          "change"
        ],
        "title": "ResourceChange",
        "type": "object"
      },
      "RevertEffect": {
        "description": "What was staged, and what an Apply would then do to the Cluster.\n\nThe catalog lists are the point of this model. A revert is not a paper change:\napplying it issues real DROP CATALOG statements, and \"3 catalogs will be dropped\"\nis a materially different warning from \"the configuration will be rewritten\".",
        "properties": {
          "catalogs_created": {
            "items": {
              "type": "string"
            },
            "title": "Catalogs Created",
            "type": "array"
          },
          "catalogs_dropped": {
            "description": "Catalogs an Apply will DROP. Destructive.",
            "items": {
              "type": "string"
            },
            "title": "Catalogs Dropped",
            "type": "array"
          },
          "catalogs_replaced": {
            "items": {
              "type": "string"
            },
            "title": "Catalogs Replaced",
            "type": "array"
          },
          "from_snapshot": {
            "title": "From Snapshot",
            "type": "integer"
          },
          "other_sections_stay_at": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "The Snapshot every other Section remains at. Null for a Full Rollback.",
            "title": "Other Sections Stay At"
          },
          "sections": {
            "description": "The Sections replaced in the Candidate.",
            "items": {
              "enum": [
                "catalogs",
                "client_certificates",
                "certificate_mapping",
                "permissions",
                "resource_groups",
                "event_listeners"
              ],
              "type": "string"
            },
            "title": "Sections",
            "type": "array"
          },
          "summary": {
            "description": "What this does, in words, for an Operator to read.",
            "title": "Summary",
            "type": "string"
          }
        },
        "required": [
          "from_snapshot",
          "sections",
          "summary"
        ],
        "title": "RevertEffect",
        "type": "object"
      },
      "RevertRequest": {
        "additionalProperties": false,
        "properties": {
          "snapshot": {
            "title": "Snapshot",
            "type": "integer"
          }
        },
        "required": [
          "snapshot"
        ],
        "title": "RevertRequest",
        "type": "object"
      },
      "Review": {
        "description": "The diff between the Configuration Candidate and the latest Snapshot.\n\nEvery Section is reported, not only the caller's changes: the Candidate is\nshared, and an Apply promotes everything in it.",
        "properties": {
          "base_snapshot": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "The Snapshot this Candidate was derived from; null before the first.",
            "title": "Base Snapshot"
          },
          "has_changes": {
            "title": "Has Changes",
            "type": "boolean"
          },
          "sections": {
            "items": {
              "$ref": "#/components/schemas/SectionDiff"
            },
            "title": "Sections",
            "type": "array"
          }
        },
        "required": [
          "base_snapshot",
          "has_changes",
          "sections"
        ],
        "title": "Review",
        "type": "object"
      },
      "Rollback": {
        "enum": [
          "succeeded",
          "failed"
        ],
        "title": "Rollback",
        "type": "string"
      },
      "RollbackRequest": {
        "additionalProperties": false,
        "properties": {
          "snapshot": {
            "title": "Snapshot",
            "type": "integer"
          }
        },
        "required": [
          "snapshot"
        ],
        "title": "RollbackRequest",
        "type": "object"
      },
      "SectionDiff": {
        "properties": {
          "changes": {
            "items": {
              "$ref": "#/components/schemas/ResourceChange"
            },
            "title": "Changes",
            "type": "array"
          },
          "section": {
            "enum": [
              "catalogs",
              "client_certificates",
              "certificate_mapping",
              "permissions",
              "resource_groups",
              "event_listeners"
            ],
            "title": "Section",
            "type": "string"
          }
        },
        "required": [
          "section"
        ],
        "title": "SectionDiff",
        "type": "object"
      },
      "Snapshot": {
        "properties": {
          "apply_id": {
            "description": "The Apply that produced this Snapshot.",
            "title": "Apply Id",
            "type": "string"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "number": {
            "description": "Sequential within this Cluster.",
            "title": "Number",
            "type": "integer"
          },
          "sections": {
            "additionalProperties": {
              "additionalProperties": true,
              "type": "object"
            },
            "propertyNames": {
              "enum": [
                "catalogs",
                "client_certificates",
                "certificate_mapping",
                "permissions",
                "resource_groups",
                "event_listeners"
              ]
            },
            "title": "Sections",
            "type": "object"
          }
        },
        "required": [
          "number",
          "sections",
          "created_at",
          "apply_id"
        ],
        "title": "Snapshot",
        "type": "object"
      },
      "Stage": {
        "enum": [
          "validating",
          "applying",
          "verifying",
          "committing",
          "rolling_back",
          "succeeded",
          "failed",
          "incident"
        ],
        "title": "Stage",
        "type": "string"
      },
      "StageEvent": {
        "properties": {
          "at": {
            "format": "date-time",
            "title": "At",
            "type": "string"
          },
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Detail"
          },
          "stage": {
            "$ref": "#/components/schemas/Stage"
          }
        },
        "required": [
          "stage",
          "at"
        ],
        "title": "StageEvent",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "ValidationFailure": {
        "description": "One reason a Candidate should not be applied, named well enough for an\nOperator to know what to fix.",
        "properties": {
          "reason": {
            "title": "Reason",
            "type": "string"
          },
          "resource": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Resource"
          },
          "section": {
            "anyOf": [
              {
                "enum": [
                  "catalogs",
                  "client_certificates",
                  "certificate_mapping",
                  "permissions",
                  "resource_groups",
                  "event_listeners"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Section"
          }
        },
        "required": [
          "reason"
        ],
        "title": "ValidationFailure",
        "type": "object"
      },
      "ValidationRecord": {
        "properties": {
          "base_snapshot": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Base Snapshot"
          },
          "failures": {
            "description": "Every reason the Candidate should not be applied, not just the first.",
            "items": {
              "$ref": "#/components/schemas/ValidationFailure"
            },
            "title": "Failures",
            "type": "array"
          },
          "finished_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Finished At"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "outcome": {
            "$ref": "#/components/schemas/Outcome"
          },
          "started_at": {
            "format": "date-time",
            "title": "Started At",
            "type": "string"
          }
        },
        "required": [
          "id",
          "outcome",
          "started_at"
        ],
        "title": "ValidationRecord",
        "type": "object"
      }
    }
  },
  "info": {
    "summary": "Control plane for configuring one Trino cluster",
    "title": "Apchi",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/admin/maintenance-mode": {
      "get": {
        "operationId": "get_maintenance_mode_api_v1_admin_maintenance_mode_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MaintenanceState"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Whether Operator changes are currently disabled",
        "tags": [
          "admin"
        ]
      },
      "put": {
        "description": "Releasing is how an incident is closed: an Admin has looked at the Cluster and\nis satisfied it is in a state Operators can safely edit again.",
        "operationId": "set_maintenance_mode_api_v1_admin_maintenance_mode_put",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MaintenanceState"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MaintenanceState"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Disable or re-enable Operator changes",
        "tags": [
          "admin"
        ]
      }
    },
    "/api/v1/applies": {
      "get": {
        "operationId": "list_applies_api_v1_applies_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ApplyRecord"
                  },
                  "title": "Response List Applies Api V1 Applies Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Past and current Applies",
        "tags": [
          "applies"
        ]
      },
      "post": {
        "operationId": "start_apply_api_v1_applies_post",
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApplyRecord"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Promote the Configuration Candidate",
        "tags": [
          "applies"
        ]
      }
    },
    "/api/v1/applies/{apply_id}": {
      "get": {
        "operationId": "get_apply_api_v1_applies__apply_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "apply_id",
            "required": true,
            "schema": {
              "title": "Apply Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApplyRecord"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "One Apply's progress",
        "tags": [
          "applies"
        ]
      }
    },
    "/api/v1/applies/{apply_id}/events": {
      "get": {
        "description": "Streams every stage transition, replaying the ones already past.\n\nA client that reconnects sends Last-Event-ID; everything after it is replayed,\nso a dropped connection does not leave a blank timeline.",
        "operationId": "stream_apply_api_v1_applies__apply_id__events_get",
        "parameters": [
          {
            "in": "path",
            "name": "apply_id",
            "required": true,
            "schema": {
              "title": "Apply Id",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "Last-Event-ID",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Last-Event-Id"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Stream stage transitions",
        "tags": [
          "applies"
        ]
      }
    },
    "/api/v1/candidate/reset": {
      "post": {
        "description": "Re-derives the Candidate from the latest Snapshot.\n\nBecause nothing reaches the Cluster before Apply, this cannot affect production.",
